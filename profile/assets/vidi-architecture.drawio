        <mxCell id="colab_h" value="&lt;b style=&quot;font-size:17px;color:#1F3C88&quot;&gt;Google Colab · 분석 파이프라인&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#424242&quot;&gt;계정 · 문장 · 시간의 관계로 조직적 바이럴 후보를 찾는다.&lt;br&gt;노트북을 직접 실행하고 단계별로 저장한다.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="245" y="32" width="345" height="80" as="geometry" />
        </mxCell>
        <mxCell id="colab_ic" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="1">
