        <mxCell id="python_ic" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="203" y="46" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b style=&quot;font-size:14px;color:#1F3C88&quot;&gt;1 댓글 수집&lt;/b&gt;&lt;br&gt;&lt;br&gt;대상 영상의 댓글, 답글, 채널 생성일을 받아 원본 JSON으로 저장한다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5882E8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="145" y="220" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b style=&quot;font-size:14px;color:#1F3C88&quot;&gt;2 대상 선별&lt;/b&gt;&lt;br&gt;&lt;br&gt;광고, 협찬, 제품 제공 표시가 없는 댓글만 남긴다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5882E8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="372" y="220" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:14px;color:#1F3C88&quot;&gt;3 전처리 · 제품 추출 · 관련 표현 찾기&lt;/b&gt;&lt;br&gt;&lt;br&gt;정규화 후 제품 사전으로 제품을 찾고, 틀을 만들기 전에 관련 표현(치료됐어요 등)과 위치를 기록한다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5882E8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="599" y="220" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b style=&quot;font-size:14px;color:#1F3C88&quot;&gt;4 틀 유사도 계산&lt;/b&gt;&lt;br&gt;&lt;br&gt;제품·고민·효과 단어를 가린 틀을 글자 조각(n-gram)으로 나눠 TF-IDF로 바꾸고, 코사인 유사도를 계산한다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5882E8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="826" y="220" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b style=&quot;font-size:14px;color:#1F3C88&quot;&gt;5 군집 생성&lt;/b&gt;&lt;br&gt;&lt;br&gt;계정과 댓글을 묶고 기준 미달을 뺀 뒤 대표 제품을 지정한다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5882E8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="145" y="410" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b style=&quot;font-size:14px;color:#1F3C88&quot;&gt;6 신호 계산&lt;/b&gt;&lt;br&gt;&lt;br&gt;계정, 문장, 시간 신호를 군집별로 계산한다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5882E8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="372" y="410" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b style=&quot;font-size:14px;color:#1F3C88&quot;&gt;7 보정 · 점수&lt;/b&gt;&lt;br&gt;&lt;br&gt;제품 인지도 기준선과 비교해 군집 점수를 낸다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5882E8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="599" y="410" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b style=&quot;font-size:14px;color:#1F3C88&quot;&gt;8 결과 저장&lt;/b&gt;&lt;br&gt;&lt;br&gt;증거와 점수(&lt;code&gt;law_hits&lt;/code&gt; 포함)를 저장하고 마지막에 manifest.json을 올린다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5882E8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="826" y="410" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ref_note" value="레코드에는 &lt;b&gt;law_hits(표현·위치·조항 ID)&lt;/b&gt;만 붙이고, 법령 본문은 조회 시 결합 · RAG 미사용(결정적 매핑)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#424242;" vertex="1" parent="1">
